# =====================================================================
# MAU CAU HINH API KEYS CHO HE THONG GOI Y PHIM (ATI)
# Cach dung: Copy file nay thanh file ".env" o thu muc goc va dien key cua ban vao.
# =====================================================================

# 1. Google Gemini API Key (Lay mien phi tai: https://aistudio.google.com/app/apikey)
# Dung de phan tich y dinh va suy luan phim bang AI trong muc "Hom nay xem gi?"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI API Key (Tuy chon - neu khong dung Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. TMDB API Key (Lay mien phi tai: https://www.themoviedb.org/settings/api)
# Dung de tai Poster, Trailer YouTube va ban dich tom tat phim tieng Viet
TMDB_API_KEY=your_tmdb_api_key_here
